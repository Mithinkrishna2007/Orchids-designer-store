# Meta WhatsApp Cloud API credentials — never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_APP_SECRET=

# ORCHIDS configuration
ORCHIDS_BUSINESS_NUMBER=919384046656
ORCHIDS_WEBSITE_URL=https://your-live-orchids-domain.example
ORCHIDS_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Orchids+Designer+Store+KK+Nagar+Sundakkamuthur+Coimbatore+641010

# Secure staff handover controls
# Use a long random secret. Required for POST /admin/conversations/:phone/resume.
HANDOVER_ADMIN_TOKEN=replace-with-a-long-random-value
# Optional private HTTPS endpoint for a staff notification system (Slack/Teams/internal app).
HANDOVER_NOTIFICATION_WEBHOOK=

# Server configuration
PORT=3000
CONVERSATION_STORE_PATH=./data/conversations.json
